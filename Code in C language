int executarQuiz(const char *perguntas[], char gabarito[], int totalPerguntas) {
    int acertos = 0, indices[10];
    char resposta;

    for (int i = 0; i < totalPerguntas; i++) {
        indices[i] = i;
    }

    srand(time(NULL));
    for (int i = totalPerguntas - 1; i > 0; i--) {
        int j = rand() % (i + 1);
        int temp = indices[i];
        indices[i] = indices[j];
        indices[j] = temp;
    }

    for (int i = 0; i < totalPerguntas; i++) {
        system("cls");
        printf("Pergunta %d:\n%s\n", i + 1, perguntas[indices[i]]);
        printf("\nPrima (v)erdadeiro ou (f)also: ");
    
	do {
    
	resposta = toupper(getch());
    if (resposta != 'V' && resposta != 'F') {
    system("color 47");
	printf("\n\n\aEntrada inválida! Pressione apenas V ou F.\nR:");
	Sleep(1000);
	system("color 07");
	   
	}
    
	} while (resposta != 'V' && resposta != 'F');
    printf("%c\n", resposta);
    

        if (resposta == gabarito[indices[i]]) {
            acertos++;
        }
        Sleep(100); 
    }

    return acertos;
}

